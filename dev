#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

board_args() {
    case "${1:-}" in
        rp2040) package=dedi-rp2040; target=thumbv6m-none-eabi; chip=RP2040; toolchain=stable; extra=() ;;
        stm32f103) package=dedi-stm32f103; target=thumbv7m-none-eabi; chip=STM32F103C8; toolchain=stable; extra=() ;;
        ch32v307) package=dedi-ch32v307; target=boards/ch32v307/riscv32imfc-unknown-none-elf.json; chip=CH32V307VCT6; toolchain=nightly; extra=(-Zbuild-std=core -Zjson-target-spec) ;;
        *) echo 'board: rp2040 | ch32v307 | stm32f103' >&2; exit 2 ;;
    esac
}
format() {
    # Keep any local path overrides outside this workspace untouched.
    cargo fmt -p dedi-protocol -p dedi-core -p dedibridgectl -p dedi-rp2040 -p dedi-stm32f103 -p dedi-ch32v307 "$@"
}
case "${1:-}" in
    fmt) format ;;
    build|flash|size|clippy)
        action=$1; board_args "${2:-}"
        if [[ "$action" == clippy ]]; then
            cargo "+$toolchain" clippy --release --locked -p "$package" --target "$target" "${extra[@]}" -- -D warnings
            exit
        fi
        cargo "+$toolchain" build --release --locked -p "$package" --target "$target" "${extra[@]}"
        target_dir=$(basename "$target" .json)
        elf="target/$target_dir/release/$package"
        case "$action" in
            flash) probe-rs run --chip "$chip" --rtt-channel-mode no-block-skip "$elf" ;;
            size) llvm-size "$elf" ;;
        esac
        ;;
    test)
        cargo test --locked
        (cd integrations/dutctl && go test -race ./...)
        ;;
    check)
        format -- --check
        cargo clippy --locked --all-targets -- -D warnings
        for board in rp2040 stm32f103 ch32v307; do
            "$0" clippy "$board"
            "$0" build "$board"
        done
        ;;
    artifacts)
        mkdir -p artifacts
        for board in rp2040 stm32f103 ch32v307; do
            "$0" build "$board"
            board_args "$board"
            cp "target/$(basename "$target" .json)/release/$package" "artifacts/$package.elf"
        done
        elf2uf2-rs artifacts/dedi-rp2040.elf artifacts/dedi-rp2040.uf2
        ;;
    host) shift; cargo run --locked -p dedibridgectl -- "$@" ;;
    *) echo 'usage: ./dev {build|flash|size|clippy} BOARD | fmt | test | check | artifacts | host [args...]' >&2; exit 2 ;;
esac
