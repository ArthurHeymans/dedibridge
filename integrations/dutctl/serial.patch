+// Copyright (c) 2026 Arthur Heymans
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+// These tests run after applying serial.patch in a dutctl checkout.
+package serial
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/BlindspotSoftware/dutctl/internal/test/mock"
+	"gopkg.in/yaml.v3"
+)
+
+func TestDediSocketConfigurationAndSendExpect(t *testing.T) {
+	writes := make(chan string, 1)
+	socket := testBridge(t, func(conn net.Conn, decoder *json.Decoder, encoder *json.Encoder) {
+		for {
+			var request bridgeRequest
+			if decoder.Decode(&request) != nil {
+				return
+			}
+			switch request.Op {
+			case "reset_input":
+				_ = encoder.Encode(bridgeMessage{Type: "reset_input"})
+				uart(encoder, []byte("boot>\r\n"))
+			case "write":
+				data, _ := base64.StdEncoding.DecodeString(request.Data)
+				writes <- string(data)
+				_ = encoder.Encode(bridgeMessage{Type: "written"})
+				uart(encoder, []byte("result: OK\r\n"))
+			}
+		}
+	})
+	var serial Serial
+	if err := yaml.Unmarshal([]byte(fmt.Sprintf("dedi_socket: %q\nbaud: 115200\ndelay: 0s\n", socket)), &serial); err != nil {
+		t.Fatal(err)
+	}
+	if serial.DediSocket != socket {
+		t.Fatal("configuration did not select socket transport")
+	}
+	if err := serial.Init(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if err := serial.Run(ctx, &mock.Session{}, "--", "expect", "boot>", "send", "help", "expect", "result: OK"); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case data := <-writes:
+		if data != "help\r" {
+			t.Fatalf("send %q", data)
+		}
+	default:
+		t.Fatal("no UART write")
+	}
+	serial.Port = "/dev/ttyUSB0"
+	if err := serial.Init(context.Background()); err == nil {
+		t.Fatal("ambiguous transport configuration accepted")
+	}
+}
